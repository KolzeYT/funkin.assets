<?xml version="1.0" encoding="utf-8"?>
<collapsible-dialog title="Keyframe Properties" width="300" height="492">
  <vbox width="100%" height="100%">
    <frame text="Properties" width="100%" height="95%" horizontalAlign="center">
      <vbox width="100%" height="100%">
        <scrollview width="100%" height="100%" contentWidth="100%">
          <grid columns="2" width="100%">
            <label text="Time" verticalAlign="center" horizontalAlign="center" />
            <number-stepper id="timePos" step="0.01" pos="0" />
            <label text="Value" verticalAlign="center" horizontalAlign="center" />
            <number-stepper id="valuePos" step="1" pos="0" />
          </grid>
        </scrollview>
      </vbox>
    </frame>
  </vbox>
</collapsible-dialog>
