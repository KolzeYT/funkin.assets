<splitter direction="vertical" width="100%" height="700" verticalAlign="center" horizontalAlign="bottom">
    <splitter direction="horizontal" width="100%" height="66%">
        <box width="100%" height="100%" style="background-color: #FFAAAA;background-opacity:0;clip:false;" >
            <import source="components/assets-list.xml" />
        </box>
    </splitter>
    <splitter direction="horizontal" width="100%" height="34%">
        <box width="100%" height="100%" style="background-color: #3D3F41; clip:true;">
            <number-stepper id="timelineLength" step="0.1" min="0.1" pos="1" precision="2" horizontalAlign="right" tooltip="Cutscene length (seconds)"/>
            <button id="timelinePlay" width="70" height="70" horizontalAlign="left"/>
        </box>
    </splitter>
</splitter>
